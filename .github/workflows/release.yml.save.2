name: 📦 Publish to npm

on:
  push:
    tags:
      - 'v*.*.*'

jobs:
  publish:
    runs-on: ubuntu-latest

    steps:
      - name: 📥 Repo-nu klonla
        uses: actions/checkout@v3

      - name: ⚙️ Node.js qur
        uses: actions/setup-node@v3
        with:
          node-version: '18'
          registry-url: 'https://registry.npmjs.org/'

      - name: 📦 Asılılıqları qur
        run: npm install

      - name: 🚀 NPM-ə yüklə
        run: npm publish
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
